                <Text style={[styles.measurementOptionValue, { color: subTextColor }]}>
                  {height || 'Not set'}
                </Text>
              </View>
              <Icon name="chevron-forward" size={20} color={subTextColor} />
            </TouchableOpacity>
            
            <TouchableOpacity 
